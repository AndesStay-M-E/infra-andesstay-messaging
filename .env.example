# =====================================================================
# Copia este archivo como ".env" (en la misma carpeta) y cambia las claves.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# =====================================================================

# ---------------- RabbitMQ (mq/compose.yml) ----------------
RABBITMQ_USER=andesstay
RABBITMQ_PASSWORD=cambia_esta_clave
# Secreto compartido por los 2 nodos para formar el clúster (solo letras y números).
RABBITMQ_ERLANG_COOKIE=CambiaEstaCookie123

# ---------------- Kafka (kafka/compose.yml) ----------------
# Dirección con la que los microservicios llegan a los brokers DESDE FUERA de Docker.
#   - En tu PC: localhost
#   - En AWS (ec2-kafka): la IP PRIVADA de la instancia ec2-kafka (ej. 172.31.20.30)
KAFKA_ADVERTISED_HOST=localhost
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=cambia_esta_clave

# ---------------- Microservicios (apps/compose.yml) ----------------
# En tu PC deja estas dos líneas comentadas: se usan los nombres de Docker.
# En AWS (ec2-apps) descoméntalas con las IP PRIVADAS de ec2-mq y ec2-kafka:
# RABBITMQ_ADDRESSES=172.31.20.20:5672,172.31.20.20:5673
# KAFKA_BOOTSTRAP_SERVERS=172.31.20.30:9092,172.31.20.30:9093,172.31.20.30:9094

# Tiempo (ms) que cada consumidor RabbitMQ espera antes de procesar un mensaje,
# para que se vea en la consola de RabbitMQ. 0 = sin espera.
RABBIT_PROCESSING_DELAY_MS=10000

# Retardo (ms) por evento en el consumidor Kafka de reportería. 0 = tiempo real.
# Súbelo (ej. 3000) para mostrar el consumer lag en Kafka UI.
KAFKA_PROCESSING_DELAY_MS=0

# Orígenes que pueden llamar al BFF (separados por coma, sin "/" al final).
# Agrega la URL de CloudFront o Amplify donde publiques el frontend.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Registro público de invitados (Microsoft Graph). Dejar en false.
REGISTRATION_ENABLED=false
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
REGISTRATION_REDIRECT_URL=https://main.d32i73fsq9ui1t.amplifyapp.com/login
